      "android": {
        "buildType": "app-bundle",
        "releaseChannel": "production"
      },
      "ios": {
        "simulator": false,
        "releaseChannel": "production"
      }
    },
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "android": {
